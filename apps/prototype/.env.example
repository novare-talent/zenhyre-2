# Where the Zenhyre API lives. The browser never calls it directly; the app's route handlers do.
API_URL=http://localhost:4000
# Session cookies are marked Secure automatically on https. Set to 1 or 0 only to override.
# COOKIE_SECURE=1
# Cashfree JS checkout mode: sandbox or production. Not a secret; the keys stay on the API.
NEXT_PUBLIC_CASHFREE_MODE=sandbox
