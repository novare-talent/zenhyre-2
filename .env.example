# The API and database scripts do not load this file: export these in your shell.
# The web app's settings (API_URL, COOKIE_SECURE) are in apps/prototype/.env.example.
DATABASE_URL=postgres://zenhyre:zenhyre@localhost:5433/zenhyre
# Against Supabase: the zenhyre_api role through the session pooler (port 5432), see docs/supabase.md.
# DATABASE_URL=postgres://zenhyre_api.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Sign-in (Supabase Auth). Server-only: never expose the service role key to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects (ours, for now): set this to verify tokens locally. Unset, the API asks Supabase per token
# (cached a minute). Leave unset once the project uses asymmetric signing keys (JWKS is used).
# SUPABASE_JWT_SECRET=
# fake = offline dev: in-memory sign-in, links print to the log, accounts vanish on restart. Refused in production.
# AUTH_PROVIDER=fake
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
TURBO_TELEMETRY_DISABLED=1
# Sender for real email. Default: Zenhyre <no-reply@zenhyre.com>
# MAIL_FROM=
# API port. Default: 4000
# PORT=4000
# none = no dev fixture at the gate, so roles wait for staff as they do in production
# GATE_MODEL=none
# off = do not run the scheduled jobs on the in-process timer
# SCHEDULER=off

# --- Deposits: Cashfree Payment Gateway (docs/superpowers/plans/2026-11-21-cashfree-deposits.md) ---
# fake = offline dev and tests: no Cashfree calls, checkout is simulated. cashfree = real gateway. Refused as fake in production.
PAYMENT_PROVIDER=fake
# sandbox -> https://sandbox.cashfree.com/pg   production -> https://api.cashfree.com/pg
CASHFREE_ENV=sandbox
# Dashboard -> Payment Gateway -> Developers -> API Keys. Server-only: never expose to the browser or commit.
CASHFREE_APP_ID=
# Also verifies webhook signatures (HMAC-SHA256 of timestamp + raw body).
CASHFREE_SECRET_KEY=
# Pinned API version sent as x-api-version.
CASHFREE_API_VERSION=2026-01-01
# Public base URL of this API. Cashfree posts webhooks to API_PUBLIC_URL/webhooks/cashfree (use an ngrok URL in sandbox).
API_PUBLIC_URL=http://localhost:4000
# How long a checkout order stays payable before a new one is created.
CASHFREE_ORDER_EXPIRY_MINUTES=60
# Optional, only if refunds outside Cashfree's 6-month window go out through Cashfree Payouts instead of by hand.
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
