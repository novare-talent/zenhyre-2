    "@zenhyre/shared": "workspace:*",
    "hono": "^4.6.0",
    "jose": "5.9.6",
    "pg-boss": "10.1.5",
    "svix": "^1.40.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
