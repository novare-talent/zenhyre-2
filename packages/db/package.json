{
  "name": "@zenhyre/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema/index.js",
    "./test": "./dist/test/setup.js",
    "./orm": "./dist/orm.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../services/api/.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../services/api/.env src/seed.ts",
    "test": "vitest run",
    "sql:bundle": "node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "@zenhyre/shared": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
